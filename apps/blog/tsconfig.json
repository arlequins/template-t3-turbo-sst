{
  "extends": "@acme/tsconfig/base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["ES2022", "dom", "dom.iterable"],
    "paths": {
      "~/*": ["./src/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": ["src", "scripts", "next.config.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", "out"]
}
